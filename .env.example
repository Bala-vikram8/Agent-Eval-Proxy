# Copy to .env. Only OPENAI_API_KEY is needed for the default setup against OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Optional: a different OpenAI compatible upstream and its key. OPENAI_API_KEY is never sent
# to a non OpenAI upstream.
# UPSTREAM_BASE=https://api.openai.com
# UPSTREAM_API_KEY=

# Recommended: require callers to send this value as their API key. Also protects /metrics.
# PROXY_API_KEY=

# Recommended: password for the dashboard (a shared secret, not per-user accounts).
# DASHBOARD_PASSWORD=

# Pattern redaction of SSNs, emails, phone and card numbers before anything is stored.
REDACT_PII=true

# Delete traces, evaluations and reviews older than this many days. 0 keeps everything.
RETENTION_DAYS=0

# Judge used by the eval worker. JUDGE_BASE_URL and JUDGE_API_KEY point it elsewhere.
JUDGE_MODEL=gpt-4o-mini
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# Model the demo agent uses.
DEMO_MODEL=gpt-4o-mini

POSTGRES_USER=agenteval
# Change this. The default is only acceptable because the port binds to 127.0.0.1.
POSTGRES_PASSWORD=agenteval
POSTGRES_DB=agenteval
PROXY_PORT=8000
DASHBOARD_PORT=8501
POSTGRES_PORT=5432
