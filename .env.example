# Development configuration only. Never commit actual credentials.
# For a synthetic offline run use docker-compose.offline.yml instead.
# Secure mode fails startup until independent strong credentials are supplied.
PROXY_API_KEY=
DASHBOARD_PASSWORD=
OPENAI_API_KEY=
ALLOW_INSECURE_LOCAL=false
TRACE_CONTENT_MODE=metadata

# Optional: a fixed alternative HTTPS provider and separate credential.
# UPSTREAM_BASE=https://api.openai.com
# UPSTREAM_API_KEY=
# Proxy/Provider secret-file variants are also supported by the runtime.

JUDGE_MODEL=gpt-4o-mini
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
JUDGE_SAMPLE_RATE=1
# EVAL_REFERENCE_CATALOG=/run/config/references.json
# EVAL_CONFIG_FILE=/run/config/evaluators.json

# Local-only example database identities. Replace independently for cloud use.
POSTGRES_USER=agenteval
POSTGRES_PASSWORD=agenteval
POSTGRES_DB=agenteval
INGEST_DB_PASSWORD=ingest_dev_only
EVAL_DB_PASSWORD=eval_dev_only
DASHBOARD_DB_PASSWORD=dashboard_dev_only
MONITOR_DB_PASSWORD=monitor_dev_only
PROXY_PORT=8000
DASHBOARD_PORT=8501
POSTGRES_PORT=5432
DEMO_MODEL=gpt-4o-mini
