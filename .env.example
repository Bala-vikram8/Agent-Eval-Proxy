# Copy to .env. Only OPENAI_API_KEY is needed for the default setup against OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Optional: a different OpenAI compatible upstream and its key. OPENAI_API_KEY is never sent
# to a non OpenAI upstream.
# UPSTREAM_BASE=https://api.openai.com
# UPSTREAM_API_KEY=

# Optional: require callers to send this value as their API key.
# PROXY_API_KEY=

# Judge used by the eval worker. JUDGE_BASE_URL and JUDGE_API_KEY point it elsewhere.
JUDGE_MODEL=gpt-4o-mini
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# Model the demo agent uses.
DEMO_MODEL=gpt-4o-mini

POSTGRES_USER=agenteval
POSTGRES_PASSWORD=agenteval
POSTGRES_DB=agenteval
PROXY_PORT=8000
DASHBOARD_PORT=8501
POSTGRES_PORT=5432
